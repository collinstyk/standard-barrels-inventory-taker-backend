DATABASE_URL=postgresql://user:password@localhost:5432/database_name
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
PORT=5000
BUSINESS_TIME_ZONE=Africa/Lagos
INVENTORY_V2_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false

# One-time administrator bootstrap variable names (supply private values only when running the command):
# ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_BOOTSTRAP_NAME=<administrator name>
# ADMIN_BOOTSTRAP_EMAIL=<administrator email>
# ADMIN_BOOTSTRAP_PASSWORD=<private password of 12 to 128 characters>
