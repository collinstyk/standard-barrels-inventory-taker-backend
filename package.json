  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism --maxWorkers=1",
    "test:all": "vitest run --no-file-parallelism --maxWorkers=1",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "bootstrap:admin": "tsx scripts/bootstrapAdminCli.ts",
    "start": "node dist/index.js",
    "studio": "prisma studio"
  },
